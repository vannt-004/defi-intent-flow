GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
ASSISTANT_DEFAULT_LANGUAGE=English
# default = deterministic NLP router. google = always call Google AI Studio when key exists. auto = legacy Google-first fallback.
ASSISTANT_PROVIDER_MODE=default
PRICE_AT_TX_MAX_DELTA_SECONDS=86400
INITIAL_CASHFLOW_LOOKBACK_DAYS=180
FULL_HISTORY_START_BLOCK=0
FULL_HISTORY_SYNTHETIC_BACKFILL_DAYS=180
CASHFLOW_PROVIDER_EVENT_LIMIT=1000

# Optional: OpenAI-compatible provider for Simulator natural-language intent parsing only.
# The Dashboard Assistant chat path currently uses Google AI Studio plus deterministic fallback.
INTENT_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
